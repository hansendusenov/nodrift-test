# Nama aplikasi sewa mobil
VITE_APP_NAME="RentCar Pro"

# Nomor kontak WhatsApp customer service untuk konfirmasi rental (format internasional tanpa tanda +, cth: 6281234567890)
VITE_WHATSAPP_CONTACT="6281234567890"

# Currency formatting locale
VITE_DEFAULT_CURRENCY="IDR"

# PIN gerbang panel staf di #/admin.
# PERINGATAN: nilai ini ikut terkirim ke browser dan bisa dibaca siapa pun
# lewat DevTools. Ini hanya penjaga tampilan untuk mockup, BUKAN autentikasi.
# Jangan gunakan PIN yang sama dengan sistem lain.
VITE_ADMIN_PIN="2468"
